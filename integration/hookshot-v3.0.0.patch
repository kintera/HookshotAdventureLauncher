+/* Songs are saved IsGet flags, not pouch items. */
+static void HAL_oot_rando_starting_songs(Ctx *c) {
+#if defined(HOOKSHOT_DEV_RANDOMIZER)
+    static const char *const songs[] = {
+        "Item_Melody_ZeldaLullaby", "Item_Melody_EponaSong", "Item_Melody_SariaSong", "Item_Melody_SunSong",
+        "Item_Melody_TimeSong", "Item_Melody_StormSong", "Item_Melody_ForestMinuet", "Item_Melody_FireBolero",
+        "Item_Melody_WaterSerenade", "Item_Melody_ShadowNocturne", "Item_Melody_SpiritRequiem", "Item_Melody_LightPrelude"
+    };
+    const char *value = getenv("HOS_RANDO_STARTING_SONGS");
+    if (!value || !*value) return;
+    char *end = NULL;
+    const unsigned long mask = strtoul(value, &end, 10);
+    if (end == value || *end || mask > 4095) return;
+    static int64_t next_check;
+    const int64_t now = hos_now_ns();
+    if (now < next_check) return;
+    next_check = now + 1000000000LL;
+    for (unsigned i = 0; i < sizeof songs / sizeof songs[0]; i++) {
+        if (!(mask & (1u << i))) continue;
+        int learned = 0;
+        const uint32_t flag = oot_song_flag(songs[i]);
+        if (flag && oot_gamedata_bool(c, flag, &learned) && !learned) oot_gamedata_queue_bool(c, flag, 1);
+    }
+#else
+    (void)c;
+#endif
+}
