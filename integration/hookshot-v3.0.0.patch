+    if (!stbtt_InitFont(&font, hookshot_font_strong, stbtt_GetFontOffsetForIndex(hookshot_font_strong, 0))) return m;
+    const float scale = stbtt_ScaleForPixelHeight(&font, (float)px);
+    std::vector<int> chars;
+    for (const unsigned char* p = (const unsigned char*)s; *p;) {
+        unsigned c = *p++;
+        if (c >= 0xc2 && c <= 0xf4) {
+            unsigned n = c < 0xe0 ? 1 : c < 0xf0 ? 2 : 3;
+            c &= n == 1 ? 31 : n == 2 ? 15 : 7;
