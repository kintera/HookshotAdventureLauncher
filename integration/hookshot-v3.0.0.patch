+/* The castle stealth skip grants its story items once per save. The saved
+   IsGet flag prevents a consumed or traded letter from being recreated. */
+static void HAL_oot_rando_child_stealth(Ctx *c) {
+#if defined(HOOKSHOT_DEV_RANDOMIZER)
+    const char *enabled = getenv("HOS_RANDO_CHILD_STEALTH");
+    if (!enabled || strcmp(enabled, "1")) return;
+    static int64_t next_check;
+    const int64_t now = hos_now_ns();
+    if (now < next_check) return;
+    next_check = now + 1000000000LL;
+    int acquired = 0;
+    if (oot_gamedata_bool(c, 0xf19393b5u, &acquired) && !acquired) { /* IsGet.Item_ZeldaLetter */
+        int held = oot_pouch_count(c, "Item_ZeldaLetter");
+        if (held == 0 && oot_pouch_change(c, "Item_ZeldaLetter", 1) >= 0)
+            held = oot_pouch_count(c, "Item_ZeldaLetter");
+        if (held > 0) oot_gamedata_queue_bool(c, 0xf19393b5u, 1);
+    }
+    /* Song shuffling is not implemented yet. Refuse an unknown song rather
+       than silently granting Lullaby for a different seed reward. */
+    const char *song = getenv("HOS_RANDO_CHILD_STEALTH_SONG");
+    if (!song || !*song || !strcmp(song, "Item_Melody_ZeldaLullaby")) {
+        int learned = 0;
+        if (oot_gamedata_bool(c, 0x01c20002u, &learned) && !learned)
+            oot_gamedata_queue_bool(c, 0x01c20002u, 1); /* IsGet.Item_Melody_ZeldaLullaby */
+    }
+#else
+    (void)c;
+#endif
+}
