+static void state_debug_key(void) {
+    static int enabled = -1, was_down, tracing, baseline, last_event = -1;
+    static uint64_t last_event_ptr;
+    static uint64_t change_count;
+    if (enabled < 0) {
+        enabled = env_on("HOS_DEBUG_KEY");
+    }
+    if (!enabled) return;
+    const int down = (GetAsyncKeyState(VK_F9) & 0x8000) != 0;
+    if (down && !was_down) {
+        tracing = !tracing;
+        if (tracing) {
+            time_t now = time(NULL);
+            struct tm local;
+#ifdef _WIN32
+            const int have_time = localtime_s(&local, &now) == 0;
+#else
+            const int have_time = localtime_r(&now, &local) != NULL;
+#endif
+            const size_t path_len = have_time ? strftime(state_trace_path, sizeof state_trace_path,
+                                                         "logs/gameplay_trace_%Y-%m-%d_%H-%M-%S.log", &local) : 0;
+            state_trace_file = path_len ? fopen(state_trace_path, "w") : NULL;
+            if (!state_trace_file) hos_log("gameplay trace: could not create timestamped capture in logs/");
+            else state_trace_log("gameplay trace: capture file %s", state_trace_path);
+            baseline = 0;
+            change_count = 0;
+            last_event = -1;
+            for (int i = 0; i < STATE_TRACKED; i++) {
+                state_seen[i].valid = 0;
+                state_seen[i].cursor = 0;
+                state_seen[i].changes = (StateChanges){0};
+            }
+            state_scan_kind = 0;
+            hos_log("[DEBUG] f9 Started");
+            state_trace_log("gameplay trace: F9 started; collecting GameData changes and event-context fields; press F9 to stop");
+        } else {
+            hos_log("[DEBUG] f9 Stopped");
+            state_trace_log("gameplay trace: F9 stopped; %llu changed GameData flags observed", (unsigned long long)change_count);
+            if (state_trace_file) fclose(state_trace_file), state_trace_file = NULL;
+        }
+    }
+    was_down = down;
+    if (!tracing) return;
+
+    const uint64_t mgr = state_u64(state_u64(STATE_GAMEDATA_SLOT));
+    const uint64_t event_mgr = state_u64(state_u64(STATE_EVENTMGR_SLOT));
+    const uint64_t event_ptr = event_mgr ? state_u64(event_mgr + 104) : 0;
+    const int event = event_ptr != 0;
+    if (last_event != event || last_event_ptr != event_ptr) {
+        state_trace_log("gameplay trace: event state %s (event context %#llx)", event ? "active" : "idle",
+                (unsigned long long)event_ptr);
+        last_event = event;
+        last_event_ptr = event_ptr;
+    }
+    state_trace_event_context_words(event_ptr);
+
+    StateChanges changes = {0};
+    const int scanning = state_scan(mgr, &changes);
+    if (!baseline && !scanning) {
+        baseline = 1;
+        state_trace_log("gameplay trace: GameData baseline ready");
+    }
+    for (unsigned i = 0; i < changes.n; i++) {
+        const StateChange *c = &changes.item[i];
+        const char *kind = c->kind == KIND_BOOL ? "Bool" : c->kind == KIND_INT ? "Int" :
+                           c->kind == KIND_ENUM ? "Enum" : "UInt";
+        if (c->kind == KIND_INT)
+            state_trace_log("gameplay trace: GameData %s hash=%08x value=%d", kind, c->key, (int)(int32_t)c->value);
+        else
+            state_trace_log("gameplay trace: GameData %s hash=%08x value=%u", kind, c->key, c->value);
+        change_count++;
+    }
+    if (changes.more) {
+        state_trace_log("gameplay trace: %u additional GameData changes omitted in this sample", changes.more);
+        change_count += changes.more;
+    }
+}
