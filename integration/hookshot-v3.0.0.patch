+/* IsGet flags are per-save, persistent and start false. They prevent spent
+   consumables from being refilled on later loads of the same slot. */
+static void HAL_oot_rando_starting_consumables(Ctx *c) {
+#if defined(HOOKSHOT_DEV_RANDOMIZER)
+    static const struct { const char *item, *bag; uint32_t acquired, capacity; int max; } items[] = {
+        {"Item_DekuStick", "Item_StickBag_Small", 0xc4e21ac2u, 0x457616b0u, 10},
+        {"Item_DekuNut", "Item_NutBag_Small", 0x00c2ee37u, 0x735b00f7u, 20},
+        {"Item_DekuSeed", NULL, 0x29888e1eu, 0xae8cc742u, 30},
+        {"Item_Bomb", NULL, 0x2bb00768u, 0xe753508bu, 20},
+    };
+    const char *value = getenv("HOS_RANDO_STARTING_CONSUMABLES");
+    if (!value || !*value) return;
+    int amounts[4]; const char *p = value;
+    for (unsigned i = 0; i < 4; i++) {
+        if (*p < '0' || *p > '9') return;
+        char *end = NULL; long n = strtol(p, &end, 10);
+        if (n < 0 || n > items[i].max || (i < 3 ? *end != ',' : *end != '\0')) return;
+        amounts[i] = (int)n; p = i < 3 ? end + 1 : end;
+    }
+    static int64_t next_check;
+    const int64_t now = hos_now_ns();
+    if (now < next_check) return;
+    next_check = now + 1000000000LL;
+    for (unsigned i = 0; i < 4; i++) {
+        if (!amounts[i]) continue;
+        int acquired = 0;
+        if (!oot_gamedata_bool(c, items[i].acquired, &acquired) || acquired) continue;
+        uint64_t capacity = oot_gamedata_int_at(c, items[i].capacity);
+        if (!capacity) continue;
+        int cap = (int)(int32_t)recomp_load32(c, capacity);
+        if (cap < amounts[i]) {
+            if (items[i].bag && oot_pouch_count(c, items[i].bag) == 0)
+                oot_pouch_change(c, items[i].bag, 1);
+            continue;
+        }
+        int have = oot_pouch_count(c, items[i].item);
+        if (have < 0) continue;
+        if (have < amounts[i]) {
+            if (oot_pouch_change(c, items[i].item, amounts[i] - have) < 0) continue;
+            have = oot_pouch_count(c, items[i].item);
+        }
+        if (have >= amounts[i]) oot_gamedata_queue_bool(c, items[i].acquired, 1);
+    }
+#else
+    (void)c;
+#endif
+}
