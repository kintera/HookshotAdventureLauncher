+/* The EventMgr exposes its current context pointer, but not a public flow/action name.
+   Capture a small bounded window from that live context so repeated Navi actions can be
+   distinguished and the fields decoded against the local EventFlow resources. */
+static void state_trace_event_context_words(uint64_t context) {
+    if (!context) {
+        state_trace_event_words_valid = 0;
+        state_trace_event_context = 0;
+        return;
+    }
+    const int fresh = !state_trace_event_words_valid || state_trace_event_context != context;
+    for (unsigned i = 0; i < STATE_TRACE_EVENT_WORDS; i++) {
+        uint64_t value = 0;
+        const int readable = state_peek(context + (uint64_t)i * 8, &value, sizeof value);
+        if (!readable) continue;
+        if (fresh || value != state_trace_event_words[i])
+            state_trace_log("gameplay trace: event context +%03x %s=%016llx",
+                    i * 8, fresh ? "word" : "changed",
+                    (unsigned long long)value);
+        state_trace_event_words[i] = value;
+    }
+    state_trace_event_context = context;
+    state_trace_event_words_valid = 1;
+}
