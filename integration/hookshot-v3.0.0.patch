+        int advance = 0; stbtt_GetCodepointHMetrics(&font, chars[i], &advance, nullptr);
+        width += advance * scale;
+        if (i + 1 < chars.size()) width += stbtt_GetCodepointKernAdvance(&font, chars[i], chars[i + 1]) * scale;
+    }
+    int ascent = 0, descent = 0, gap = 0;
+    stbtt_GetFontVMetrics(&font, &ascent, &descent, &gap);
+    m.w = std::max(1, (int)std::ceil(width) + 2 * pad + 4);
+    m.h = std::max(1, (int)std::ceil((ascent - descent) * scale) + 2 * pad + 4);
+    m.cov.assign((size_t)m.w * m.h, 0);
+    float x = (float)pad + 2;
+    const int baseline = pad + 2 + (int)std::ceil(ascent * scale);
+    for (size_t i = 0; i < chars.size(); i++) {
+        int gw, gh, xoff, yoff;
+        unsigned char* bitmap = stbtt_GetCodepointBitmap(&font, scale, scale, chars[i], &gw, &gh, &xoff, &yoff);
+        for (int y = 0; bitmap && y < gh; y++) for (int xx = 0; xx < gw; xx++) {
+            const int dx = (int)x + xoff + xx, dy = baseline + yoff + y;
+            if (dx >= 0 && dx < m.w && dy >= 0 && dy < m.h)
+                m.cov[(size_t)dy * m.w + dx] = std::max(m.cov[(size_t)dy * m.w + dx], bitmap[y * gw + xx]);
+        }
+        stbtt_FreeBitmap(bitmap, nullptr);
+        int advance = 0; stbtt_GetCodepointHMetrics(&font, chars[i], &advance, nullptr);
+        x += advance * scale;
+        if (i + 1 < chars.size()) x += stbtt_GetCodepointKernAdvance(&font, chars[i], chars[i + 1]) * scale;
+    }
+    return m;
+}
