+/* Generated only into a validated randomized-profile runtime environment. Keep
+   this list limited to the map/compass flags verified in GameDataList. */
+static void HAL_oot_rando_starting_dungeon_flags(Ctx *c) {
+#if defined(HOOKSHOT_DEV_RANDOMIZER)
+    static const uint32_t allowed[] = {
+        0x89787395u, 0x06c51ff2u, 0xa52c3a19u, 0x8b93edf9u,
+        0xfcadd210u, 0x9a2218dbu, 0x77c47ec9u, 0x9d6efaacu,
+        0xb85002bau, 0x9bd1181cu,
+    };
+    const char *value = getenv("HOS_RANDO_STARTING_DUNGEON_FLAGS");
+    static char previous[256];
+    static uint32_t flags[10];
+    static unsigned count, logged;
+    static int64_t next_check;
+    if (!value || !*value || strlen(value) >= sizeof previous) {
+        previous[0] = 0; count = logged = 0; next_check = 0;
+        return;
+    }
+    if (strcmp(previous, value)) {
+        memcpy(previous, value, strlen(value) + 1);
+        count = logged = 0; next_check = 0;
+        const char *p = value;
+        while (*p && count < sizeof flags / sizeof flags[0]) {
+            char *end = NULL;
+            const unsigned long parsed = strtoul(p, &end, 16);
+            int known = 0;
+            for (unsigned i = 0; i < sizeof allowed / sizeof allowed[0]; i++)
+                if (allowed[i] == (uint32_t)parsed) known = 1;
+            if (end == p || parsed > UINT32_MAX || !known || (count && parsed == flags[count - 1]) ||
+                (*end && *end != ',')) { count = 0; previous[0] = 0; return; }
+            flags[count++] = (uint32_t)parsed;
+            p = *end ? end + 1 : end;
+        }
+        if (*p) { count = 0; previous[0] = 0; return; }
+        hos_log_at(HOS_LOG_DEBUG, "randomizer: received starting dungeon flags: %s", value);
+    }
+    /* Save data can finish loading after Link's first update, and a profile can
+       switch slots without restarting Hookshot. Reconcile periodically so a
+       later load cannot overwrite the seed's starting-item grants. */
+    const int64_t now = hos_now_ns();
+    if (now < next_check) return;
+    next_check = now + 1000000000LL;
+    for (unsigned i = 0; i < count; i++) {
+        int current = 0;
+        if (!oot_gamedata_bool(c, flags[i], &current)) continue; /* manager not ready yet */
+        if (!current && !oot_gamedata_queue_bool(c, flags[i], 1)) continue;
+        if (!(logged & (1u << i))) {
+            hos_log_at(HOS_LOG_DEBUG, "randomizer: starting dungeon flag %08X is active", flags[i]);
+            logged |= 1u << i;
+        }
+    }
+#else
+    (void)c;
+#endif
+}
+
+/* Permanent seed-local equipment: recheck after save loads and slot changes. */
+static void HAL_oot_rando_starting_equipment(Ctx *c) {
+#if defined(HOOKSHOT_DEV_RANDOMIZER)
+    static const struct { const char *name; unsigned bit; } items[] = {
+        {"Weapon_Sword_Kokiri", 1}, {"Weapon_Range_SlingShot", 2}, {"Item_BombBag_Small", 4},
+        {"Item_Boomerang", 8}, {"Item_GlassTruth", 16}, {"Weapon_Shield_Deku", 32}, {"Item_Ocarina_Fairy", 64},
+    };
+    const char *value = getenv("HOS_RANDO_STARTING_EQUIPMENT");
+    if (!value || !*value) return;
+    char *end = NULL;
+    const unsigned long mask = strtoul(value, &end, 10);
+    if (end == value || *end || mask > 127) return;
+    static int64_t next_check;
+    const int64_t now = hos_now_ns();
+    if (now < next_check) return;
+    next_check = now + 1000000000LL;
+    for (unsigned i = 0; i < sizeof items / sizeof items[0]; i++) {
+        if (!(mask & items[i].bit)) continue;
+        if (items[i].bit == 32) {   /* a Deku Shield can burn: the starting grant is once per save */
+            int acquired = 0;
+            if (!oot_gamedata_bool(c, 0x5217da1eu, &acquired) || acquired) continue; /* IsGet.Weapon_Shield_Deku */
+            int held = oot_pouch_count(c, items[i].name);
+            if (held == 0 && oot_pouch_change(c, items[i].name, 1) >= 0)
+                held = oot_pouch_count(c, items[i].name);
+            if (held > 0) oot_gamedata_queue_bool(c, 0x5217da1eu, 1);
+            continue;
+        }
+        if (items[i].bit == 4 && (oot_pouch_count(c, "Item_BombBag_Medium") > 0 ||
+                                  oot_pouch_count(c, "Item_BombBag_Large") > 0)) continue;
+        if (items[i].bit == 64 && oot_pouch_count(c, "Item_Ocarina_Time") > 0) continue;
+        const int held = oot_pouch_count(c, items[i].name);
+        if (held == 0) oot_pouch_change(c, items[i].name, 1);
+        if (items[i].bit == 2 && oot_pouch_count(c, items[i].name) > 0) {
+            /* A direct pouch grant does not run the slingshot's get event: in
+               game it otherwise appears with 0/0 seeds. Preserve any capacity
+               or upgraded bag already present in this save. */
+            const uint64_t at = oot_gamedata_int_at(c, 0xae8cc742u); /* seed-bag capacity */
+            if (!at || recomp_load32(c, at) != 0) continue;
+            int small = oot_pouch_count(c, "Item_BulletBag_Small");
+            const int medium = oot_pouch_count(c, "Item_BulletBag_Medium");
+            const int large = oot_pouch_count(c, "Item_BulletBag_Large");
+            if (small < 0 || medium < 0 || large < 0) continue;
+            if (!small && !medium && !large) {
+                if (oot_pouch_change(c, "Item_BulletBag_Small", 1) < 0) continue;
+                small = oot_pouch_count(c, "Item_BulletBag_Small");
+            }
+            if ((small > 0 || medium > 0 || large > 0) && recomp_load32(c, at) == 0)
+                recomp_store32(c, at, large > 0 ? 50 : medium > 0 ? 40 : 30);
+        }
+    }
+#else
+    (void)c;
+#endif
+}
