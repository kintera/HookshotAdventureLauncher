+/* The game's setter queues changes for both the live value and the save copy.
+   Calling it as a guest function may clobber registers, so preserve the context. */
+static int oot_gamedata_queue_bool(Ctx *c, uint32_t hash, int value) {
+    const uint64_t mgr = oot_singleton(c, OOT_GAMEDATA_SLOT);
+    A64Fn set = a64_lookup(0x806a2b20ULL);
+    int current = 0;
+    if (!mgr || !set || !oot_gamedata_bool(c, hash, &current)) return 0;
+    Ctx saved = *c;
+    c->x[0] = mgr, c->x[1] = value ? 1 : 0, c->x[2] = hash;
+    set(c);
+    *c = saved;
+    return 1;
+}
