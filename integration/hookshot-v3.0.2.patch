diff --git a/tests/test_linux_update_repository.py b/tests/test_linux_update_repository.py
new file mode 100644
index 00000000..fbfd6c19
--- /dev/null
+++ b/tests/test_linux_update_repository.py
@@ -0,0 +1,64 @@
+"""A packaged fork's updater must use that fork for every release lookup."""
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class UpdateRepository(unittest.TestCase):
+    def test_manual_update_image_never_fetches_release_data(self):
+        with tempfile.TemporaryDirectory(prefix="hookshot-manual-updates-") as folder:
+            tools = Path(folder)
+            linux = tools / "builder/linux"
+            linux.mkdir(parents=True)
+            for name in ("linux_update.py", "part_links.py"):
+                shutil.copy(ROOT / "builder/linux" / name, linux / name)
+            (tools / "HAL_MANUAL_UPDATES").touch()
+            code = '''
+import sys
+sys.path.insert(0, sys.argv[1])
+import linux_update as u
+def fail(url): raise AssertionError("unexpected network call")
+assert u.latest_tag(get=fail) is None
+assert u.all_releases(get=fail) is None
+try: u.fetch_manifest(get=fail)
+except RuntimeError as exc: assert "manually" in str(exc)
+else: raise AssertionError("manual update image fetched a manifest")
+'''
+            result = subprocess.run([sys.executable, "-I", "-B", "-c", code, str(linux)],
+                                    capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+
+    def test_packaged_repository_and_stock_default(self):
+        with tempfile.TemporaryDirectory(prefix="hookshot-update-repository-") as folder:
+            tools = Path(folder)
+            linux = tools / "builder/linux"
+            linux.mkdir(parents=True)
+            for name in ("linux_update.py", "part_links.py"):
+                shutil.copy(ROOT / "builder/linux" / name, linux / name)
+            code = ("import json, sys; sys.path.insert(0, sys.argv[1]); import linux_update as u; "
+                    "print(json.dumps([u.LATEST_LIST, u.LATEST_API, u.RELEASES_API, "
+                    "u.RELEASES_PAGE % 2, u.list_url('v3.0.0')]))")
+            def run():
+                return subprocess.run([sys.executable, "-I", "-B", "-c", code, str(linux)],
+                                      capture_output=True, text=True)
+            stock = run()
+            self.assertEqual(stock.returncode, 0, stock.stderr)
+            self.assertTrue(all("Hookshot/Hookshot" in url for url in json.loads(stock.stdout)))
+            (tools / "UPDATE_REPOSITORY").write_text("Example/Adventure\n", encoding="utf-8")
+            fork = run()
+            self.assertEqual(fork.returncode, 0, fork.stderr)
+            self.assertTrue(all("Example/Adventure" in url for url in json.loads(fork.stdout)))
+            (tools / "UPDATE_REPOSITORY").write_text("../unsafe\n", encoding="utf-8")
+            invalid = run()
+            self.assertNotEqual(invalid.returncode, 0)
+            self.assertIn("Invalid packaged update repository", invalid.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
