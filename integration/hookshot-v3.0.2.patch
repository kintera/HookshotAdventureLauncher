+/* Recover the vanilla Emerald only after both Gohma and the quest are complete.
+   Existing saves affected by a skipped reward need the same repair as new ones. */
+static void HAL_oot_rando_stone_reward(Ctx *c) {
+#if defined(HOOKSHOT_DEV_RANDOMIZER)
+    const char *enabled = getenv("HOS_RANDO_STONE_REWARD_FALLBACK");
+    if (!enabled || strcmp(enabled, "1")) return;
+    static int64_t next_check;
+    const int64_t now = hos_now_ns();
+    if (now < next_check) return;
+    next_check = now + 1000000000LL;
+    int defeated = 0, acquired = 0;
+    int64_t step = 0;
+    extern int hos_oot_gamedata_enum(uint32_t hash, int64_t *value);
+    if (!oot_gamedata_bool(c, 0x6b093b51u, &defeated) || !defeated || /* Gohma_DefeatBoss */
