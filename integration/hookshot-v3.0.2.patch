+/* Randomized adventures use a separate 20-item bombchu limit before a bomb
+   bag, then the owned bag's capacity. The fixed-limit lookup supplies the
+   parsed pouch row, whose first field is its __RowId. Never change GameData. */
+uint32_t hos_oot_bombchu_capacity(Ctx *c, uint64_t row, uint32_t fixed) {
+#if defined(HOOKSHOT_DEV_RANDOMIZER)
+    const char *enabled = getenv("HOS_RANDO_BOMBCHU_CAPACITY");
+    if (!enabled || strcmp(enabled, "1") || fixed != 20 || !row) return fixed;
+    const uint64_t name = recomp_load64(c, row);
+    if (!name) return fixed;
+    static const char bombchu[] = "Item_Bombchu";
+    for (size_t i = 0; i < sizeof bombchu; i++)
+        if (recomp_load8(c, name + i) != (uint8_t)bombchu[i]) return fixed;
+    const uint64_t at = oot_gamedata_int_at(c, 0xe753508bu);
+    if (!at) return fixed;
+    const uint32_t bag = (uint32_t)recomp_load32(c, at);
+    return bag == 30 || bag == 40 ? bag : fixed;
+#else
+    (void)c; (void)row;
+    return fixed;
+#endif
+}
