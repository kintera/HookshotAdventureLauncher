diff --git a/tests/test_oot_bombchu_capacity.py b/tests/test_oot_bombchu_capacity.py
new file mode 100644
index 00000000..49d2bf0f
--- /dev/null
+++ b/tests/test_oot_bombchu_capacity.py
@@ -0,0 +1,71 @@
+"""The randomized pouch-limit hook, compiled against game-free guest memory."""
+import subprocess
+import os
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'nx2'))
+import oot_patches as patches
+
+source = '#include "a64.h"\n' + patches.BOMBCHU_HEAD + patches.BOMBCHU_LIMIT + '\n}\n'
+made = patches.patch_bombchu_capacity(source)
+assert made and patches.BOMBCHU_HOOK in made
+assert patches.patch_bombchu_capacity(made) == made
+assert patches.patch_bombchu_capacity(source.replace(patches.BOMBCHU_LIMIT, '')) is None
+assert patches.patch_file(source, 'fixture.c', protect_hearts=False)[0] == source
+assert patches.patch_file(source, 'fixture.c', protect_hearts=True)[0] == made
+
+host = (ROOT / 'host/hos_main.c').read_text()
+start = host.index('uint32_t hos_oot_bombchu_capacity(')
+end = host.index('\n}\n', start) + 2
+helper = host[start:end]
+fixture = r'''
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <assert.h>
+#ifdef _WIN32
+#define SET_ENV(value) _putenv_s("HOS_RANDO_BOMBCHU_CAPACITY", value)
+#else
+#define SET_ENV(value) setenv("HOS_RANDO_BOMBCHU_CAPACITY", value, 1)
+#endif
+typedef struct { int unused; } Ctx;
+static unsigned char mem[512];
+static int exists = 1;
+static uint64_t recomp_load64(Ctx *c, uint64_t at) { uint64_t x; (void)c; memcpy(&x, mem + at, 8); return x; }
+static uint32_t recomp_load32(Ctx *c, uint64_t at) { uint32_t x; (void)c; memcpy(&x, mem + at, 4); return x; }
+static uint8_t recomp_load8(Ctx *c, uint64_t at) { (void)c; return mem[at]; }
+static uint64_t oot_gamedata_int_at(Ctx *c, uint32_t hash) { (void)c; assert(hash == 0xe753508bu); return exists ? 256 : 0; }
+''' + helper + r'''
+int main(void) {
+    Ctx c = {0}; uint64_t ptr = 128; memcpy(mem + 16, &ptr, 8);
+    memcpy(mem + 128, "Item_Bombchu", sizeof "Item_Bombchu");
+    uint32_t tiers[] = {0, 20, 30, 40, 999};
+    for (int i = 0; i < 5; ++i) {
+        memcpy(mem + 256, &tiers[i], 4);
+        SET_ENV("0");
+        assert(hos_oot_bombchu_capacity(&c, 16, 20) == 20);
+        SET_ENV("1");
+        assert(hos_oot_bombchu_capacity(&c, 16, 20) == (i == 2 ? 30 : i == 3 ? 40 : 20));
+        assert(hos_oot_bombchu_capacity(&c, 16, 10) == 10);
+    }
+    memcpy(mem + 128, "Item_Bomb", sizeof "Item_Bomb");
+    assert(hos_oot_bombchu_capacity(&c, 16, 20) == 20);
+    memcpy(mem + 128, "Item_Bombchu", sizeof "Item_Bombchu"); exists = 0;
+    assert(hos_oot_bombchu_capacity(&c, 16, 20) == 20);
+    assert(hos_oot_bombchu_capacity(&c, 0, 20) == 20);
+    return 0;
+}
+'''
+cc = next((path for name in ('cc', 'clang', 'gcc') if (path := shutil.which(name))), None)
+if not cc:
+    raise SystemExit('A C compiler is required for the bombchu-capacity test')
+with tempfile.TemporaryDirectory(prefix='bombchu-capacity-') as d:
+    c = Path(d) / 'fixture.c'; exe = Path(d) / ('fixture.exe' if os.name == 'nt' else 'fixture')
+    c.write_text(fixture)
+    subprocess.run([cc, '-D_GNU_SOURCE', '-DHOOKSHOT_DEV_RANDOMIZER=1', '-std=c11', '-Wall', '-Werror', str(c), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
+print('bombchu lookup: 0/20/30/40, unrelated items, disabled and missing data: ok')
