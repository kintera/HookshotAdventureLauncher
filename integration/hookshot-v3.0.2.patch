+        !oot_gamedata_bool(c, 0x110b83ecu, &acquired) || acquired) return; /* IsGet.Item_Stone_Forest */
+    int held = oot_pouch_count(c, "Item_Stone_Forest");
+    if (held == 0) oot_pouch_change(c, "Item_Stone_Forest", 1);
