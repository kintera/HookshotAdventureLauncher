<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HookshotAdventure.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="HeadingBrush" Color="#DAA520"/>
    <LinearGradientBrush x:Key="VanillaBadgeBrush" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#588261" Offset="0"/><GradientStop Color="#25422c" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="RandoBadgeBrush" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#8950a6" Offset="0"/><GradientStop Color="#3d1f57" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeBrush" Color="#17111f" />
    <SolidColorBrush x:Key="CardBrush" Color="#251c32" />
    <SolidColorBrush x:Key="ProfileCardBrush" Color="#403047" />
    <SolidColorBrush x:Key="InsetBrush" Color="#11101b" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#403047" />
    <SolidColorBrush x:Key="HoverBrush" Color="#594160" />
    <SolidColorBrush x:Key="RimBrush" Color="#6c506e" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#6c506e" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="AccentBrush" Color="#a784bf" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#f9f6fa" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#c5b9d0" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontFamily" Value="Inter, DejaVu Sans, Sans" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:focus">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="1,1,2,3" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 4 10 0 #70000000" />
    </Style>
    <Style Selector="Button.raised">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="17,11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.raised:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.raised:pressed">
      <Setter Property="BorderThickness" Value="1,3,1,1" />
      <Setter Property="Padding" Value="17,12,17,10" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#101010" />
    </Style>
    <Style Selector="Button.profile">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="1,2,1,4" />
      <Setter Property="Padding" Value="17" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.profile:pointerover">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Hookshot v0.8 shallow bevel and drop shadow, applied to individual rows. -->
    <Style Selector="Border.profileRow">
      <Setter Property="Background" Value="{DynamicResource ProfileCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="BoxShadow" Value="0 5 22 0 #87000000" />
    </Style>
    <Style Selector="Border.profileRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.previewWell">
      <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="2,2,1,1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BoxShadow" Value="inset 0 3 8 0 #89000000" />
    </Style>
    <Style Selector="Border.previewShell">
      <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="3,3,2,2" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.saveInfoFrame">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="1,1,2,3" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.saveBadge">
      <Setter Property="Background" Value="#49474d" />
      <Setter Property="BorderBrush" Value="#77747b" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.innerTray">
      <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="2,2,1,1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BoxShadow" Value="inset 0 3 10 0 #80000000" />
    </Style>
    <Style Selector="Border.statInset">
      <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,7" />
    </Style>
    <Style Selector="Border.inventoryCell">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RimBrush}" />
      <Setter Property="BorderThickness" Value="2,2,1,1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="TextBlock.microLabel">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.saveBadge.vanilla">
      <Setter Property="Background" Value="{DynamicResource VanillaBadgeBrush}"/>
      <Setter Property="BorderBrush" Value="#729778"/>
    </Style>
    <Style Selector="Border.saveBadge.rando">
      <Setter Property="Background" Value="{DynamicResource RandoBadgeBrush}"/>
      <Setter Property="BorderBrush" Value="#9b72b0"/>
    </Style>
  </Application.Styles>
</Application>
